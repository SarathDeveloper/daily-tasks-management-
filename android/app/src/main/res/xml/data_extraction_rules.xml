<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and newer: same exclusions as backup_rules.xml, for both cloud
  backup and phone-to-phone transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="dayflow_bank_sms.xml" />
        <exclude domain="sharedpref" path="dayflow_widgets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dayflow_bank_sms.xml" />
        <exclude domain="sharedpref" path="dayflow_widgets.xml" />
    </device-transfer>
</data-extraction-rules>
